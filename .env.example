# Copy this file to .env and fill in real values for Docker Compose.
# Never commit the real .env file — it's already gitignored.

# --- Database ---
DB_PASSWORD=change-me

# --- Backend (Spring Boot) ---
# Generate a long random string for production; the app has a dev-only fallback if left unset.
JWT_SECRET=
# Comma-separated list of frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Google OAuth Web client ID for "Continue with Google" (public, not a secret). Console: APIs & Services -> Credentials.
# The site's origin (e.g. https://yourshop.com) must be listed under "Authorized JavaScript origins" there.
GOOGLE_CLIENT_ID=
# Refresh-token cookie. Behind HTTPS (production) set APP_COOKIE_SECURE=true.
# Only if the frontend and API are on different *sites* (not just ports/subdomains) use SameSite=None.
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax

# --- WhatsApp new-order alerts to the shop owner (optional, via CallMeBot's free personal-use API) ---
# 1) Add CallMeBot's WhatsApp number (see https://www.callmebot.com/blog/free-api-whatsapp-messages/) to your contacts
# 2) Send it: I allow callmebot to send me messages   -> it replies with your API key
# Leave both blank to disable. CALLMEBOT_PHONE includes the country code, e.g. +919876543210.
CALLMEBOT_PHONE=
CALLMEBOT_API_KEY=

# --- Product images on Cloudinary (optional; needed on hosts with a temporary disk, e.g. Render free) ---
# Blank = images are stored on the local disk (the Docker volume) as before. See docs/deploy-free.md.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay (optional — "Pay online now" at checkout is disabled without these) ---
# Get test keys from https://dashboard.razorpay.com (Settings -> API Keys, Test Mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Frontend (Next.js) ---
# The URL the browser uses to reach the backend. Baked in at build time.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Same client ID as GOOGLE_CLIENT_ID above, baked in at build time. Leave blank to hide the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
